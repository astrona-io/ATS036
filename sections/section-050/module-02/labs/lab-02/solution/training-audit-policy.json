{
  "apiVersion": "audit.k8s.io/v1",
  "kind": "Policy",
  "omitStages": [
    "RequestReceived"
  ],
  "rules": [
    {
      "level": "Metadata",
      "resources": [
        {
          "group": "",
          "resources": [
            "pods/exec",
            "pods/portforward"
          ]
        }
      ]
    },
    {
      "level": "None",
      "resources": [
        {
          "group": "",
          "resources": [
            "pods/*"
          ]
        }
      ]
    },
    {
      "level": "Metadata",
      "namespaces": [
        "starfleet-036-050-02-02"
      ],
      "resources": [
        {
          "group": "",
          "resources": [
            "secrets"
          ]
        }
      ]
    },
    {
      "level": "None"
    }
  ]
}
