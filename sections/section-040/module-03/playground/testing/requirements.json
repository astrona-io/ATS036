{
  "context": "kind-astro-ats-036-playground-040-03",
  "resources": [
    {
      "kind": "deployment",
      "name": "probe",
      "expected": {
        "apiVersion": "apps/v1",
        "kind": "Deployment",
        "metadata": {
          "name": "probe",
          "namespace": "starfleet"
        },
        "spec": {
          "replicas": 2,
          "template": {
            "spec": {
              "containers": [
                {
                  "name": "probe",
                  "image": "docker.io/library/python:3.13-alpine",
                  "env": [
                    {
                      "name": "VERSION",
                      "value": "v2"
                    }
                  ],
                  "securityContext": {
                    "readOnlyRootFilesystem": true
                  },
                  "volumeMounts": [
                    {
                      "name": "app",
                      "mountPath": "/app",
                      "readOnly": true
                    },
                    {
                      "name": "tmp",
                      "mountPath": "/tmp"
                    }
                  ]
                }
              ],
              "volumes": [
                {
                  "name": "app",
                  "configMap": {
                    "name": "probe-code"
                  }
                },
                {
                  "name": "tmp",
                  "emptyDir": {}
                }
              ]
            }
          }
        }
      },
      "state": "deployment"
    }
  ],
  "behavior": [
    {
      "args": [
        "kubectl",
        "-n",
        "starfleet",
        "exec",
        "shuttle",
        "--",
